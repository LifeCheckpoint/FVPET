{
  "name": "@hcb-editor/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Editor presentation layer: React flow / script view / property panel / resource views / preview",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/theme/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "vite",
    "dev:test": "vite --port 5199 --strictPort --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hcb-editor/compiler": "workspace:*",
    "@hcb-editor/editor": "workspace:*",
    "@hcb-editor/hcb": "workspace:*",
    "@hcb-editor/rfvp": "workspace:*",
    "@xyflow/react": "^12.3.5",
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "storybook": "^8.4.7",
    "vite": "^5.4.10"
  }
}
